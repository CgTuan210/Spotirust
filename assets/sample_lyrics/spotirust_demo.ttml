        <span begin="00:04.600" end="00:05.200">Every</span>
        <span begin="00:05.200" end="00:05.750">beat</span>
        <span begin="00:05.750" end="00:06.150">and</span>
        <span begin="00:06.150" end="00:06.800">syllable</span>
        <span begin="00:06.800" end="00:07.500">ignites</span>
        <span begin="00:07.500" end="00:07.850">on</span>
        <span begin="00:07.850" end="00:08.500">time</span>
        <span ttm:role="x-bg" begin="00:07.900" end="00:08.500">(right on time)</span>
