    </div>
    <div itunes:song-part="Chorus">
      <p begin="00:09.000" end="00:13.400" itunes:key="L3" ttm:agent="v1">
        <span begin="00:09.000" end="00:09.500">No</span>
        <span begin="00:09.500" end="00:10.100">heavy</span>
