            <text for="L3">Không nặng nề trình duyệt, chỉ có âm nhạc và Rust</text>
            <text for="L4">Chạm nhẹ thanh tua và lời ca khớp tức thì</text>
          </translation>
        </translations>
      </iTunesMetadata>
    </metadata>
  </head>
  <body>
    <div itunes:song-part="Verse">
      <p begin="00:00.500" end="00:04.200" itunes:key="L1" ttm:agent="v1">
        <span begin="00:00.500" end="00:01.050">Pure</span>
        <span begin="00:01.050" end="00:01.550">sound</span>
