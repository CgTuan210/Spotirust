      <amll:meta key="album" value="Native Audio Showcase" />
      <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
        <translations>
          <translation xml:lang="vi" type="subtitle">
            <text for="L1">Sóng âm thuần khiết lướt qua đêm tĩnh lặng</text>
